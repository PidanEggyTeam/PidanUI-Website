{
  // assets-only Worker：没有 main 字段，纯静态资源，请求不计费。
  // 与 OpenPidanUI 官网同一套部署方式，只是 worker 名称与构建产物一致。
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pidanui-website",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": ".output/public",
    // 产物是「根页面 xxx.html + 子路径 xxx/index.html」的混合形态：
    // auto-trailing-slash 两种都能命中，URL 保持不带 .html 与尾斜杠。
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
  },
  "previews": {},
}
