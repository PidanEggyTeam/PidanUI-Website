{
  "name": "pidanuiwebsite-nuxt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxi generate && node scripts/sync-fonts.mjs",
    "generate": "nuxi generate",
    "preview": "wrangler dev",
    "preview:static": "node scripts/serve-static.mjs",
    "deploy": "pnpm build && wrangler deploy",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@nuxt/ui": "^4.12.0",
    "nuxt": "^4.6.4",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource/cascadia-code": "^5.3.0",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/simple-icons": "^1.2.100",
    "@nuxt/cli": "^4.0.3",
    "@nuxt/content": "^3.16.2",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@tailwindcss/vite": "4.3.3",
    "better-sqlite3": "^13.0.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.12.0",
    "globals": "^17.13.0",
    "gray-matter": "^4.0.3",
    "harmonyos-sans-sc-webfont-splitted": "^1.1.0",
    "katex": "^0.19.0",
    "prettier": "^3.9.10",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "tailwindcss": "4.3.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "wrangler": "^4.158.0"
  }
}
